SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key (required strictly for administrative scripts, never for client apps):
SUPABASE_SERVICE_ROLE_KEY=
LIBRIS_API_KEY=
# Flask session / CSRF secret key (required in production):
SECRET_KEY=
# Optional distributed rate limiter URL (e.g. redis://localhost:6379/0).
# If omitted, backend defaults to local thread-safe in-memory sliding window:
REDIS_URL=
