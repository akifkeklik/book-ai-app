# ─────────────────────────────────────────────────────────────
# Book AI Backend – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask Server Configuration
DEBUG=False
SECRET_KEY=replace-with-a-long-random-string

# API Security (Server-to-Server Authentication)
# Required by /api/ endpoints when called by web backend or services
LIBRIS_API_KEY=replace-with-a-secure-random-api-key

# Reverse Proxy Configuration (Number of trusted proxy hops, e.g., 1 for Render / Railway / Nginx)
NUM_PROXIES=1

# AI Assistant & RAG Provider Configuration
# Supported providers: gemini (default) or openai
# Note: Database vector embeddings use 3072 dimensions produced by Gemini.
# If LLM_PROVIDER=openai, provide GEMINI_API_KEY for embedding generation.
LLM_PROVIDER=gemini
LLM_API_KEY=your-llm-provider-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Google Books API (see docs/google_api_setup.md)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# Supabase REST / Auth Configuration (see docs/supabase_setup.md)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# IMPORTANT: Do not add SUPABASE_SERVICE_ROLE_KEY to this .env file.
# It bypasses Row Level Security. For one-off administrative ingestion only,
# inject it into that process environment from a secure secret store, then unset it.
# Never expose it to web/mobile clients or deploy it as a general application secret.

# Supabase Direct PostgreSQL Connection (Optional, used for CI migration checks or embedding scripts)
# Example: postgresql://postgres:postgrespassword@localhost:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Recommendation Engine Settings
TOP_N_RECOMMENDATIONS=10

# CORS Configuration – comma-separated origins, or * for local development only.
# Production must use explicit trusted origins; never use a wildcard.
ALLOWED_ORIGINS=*
